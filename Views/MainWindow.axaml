<atom:Window
    Height="900"
    Title="ACRF 注释工具"
    Width="1440"
    WindowStartupLocation="CenterScreen"
    x:Class="AcrfAnnotationTool.Views.MainWindow"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:atom="https://atomui.net"
    xmlns:views="using:AcrfAnnotationTool.Views"
    xmlns:vm="using:AcrfAnnotationTool.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <views:MainView />
</atom:Window>
