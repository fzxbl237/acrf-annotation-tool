<UserControl
    x:Class="AcrfAnnotationTool.Views.MainView"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:AcrfAnnotationTool.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFF3F4F6" RowDefinitions="Auto,*,Auto">
        <Border
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,0,0,1"
            Grid.Row="0"
            Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="ACRF 注释工具"
                    VerticalAlignment="Center" />
                <TextBlock
                    Foreground="#FF64748B"
                    Text="v0.44"
                    VerticalAlignment="Center" />
                <TextBlock
                    Foreground="#FF64748B"
                    Margin="12,0,0,0"
                    Text="{Binding Status}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <DockControl
            Factory="{Binding Factory}"
            Grid.Row="1"
            InitializeFactory="True"
            InitializeLayout="True"
            Layout="{Binding Layout}"
            Margin="8" />
        <Border
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,1,0,0"
            Grid.Row="2"
            Padding="10,5">
            <TextBlock Foreground="#FF64748B" Text="{Binding Status}" />
        </Border>
    </Grid>
</UserControl>
