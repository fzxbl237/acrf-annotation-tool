<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AcrfAnnotationTool.Controls"
                    xmlns:menus="using:AcrfAnnotationTool.Controls.Menus">
    <ControlTheme x:Key="{x:Type local:ButtonGroup}" TargetType="local:ButtonGroup">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22"
                            ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <Panel>
                                <menus:GlidingIndicator Name="PART_Highlight"
                                                         Fill="#FFF1F1F1"
                                                         CornerRadius="18"
                                                         Spring="Morph" />
                                <StackPanel Name="PART_Row" Orientation="Horizontal">
                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </StackPanel>
                            </Panel>
                        </ScrollViewer>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFE5E5E5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FF353535" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^:pressing /template/ menus|GlidingIndicator#PART_Highlight">
            <Setter Property="Fill" Value="#FFE3E3E3" />
        </Style>
        <Style Selector="^:solid">
            <Setter Property="Background" Value="#FF353535" />
            <Setter Property="BorderBrush" Value="#FF353535" />
            <Setter Property="Foreground" Value="White" />
            <Style Selector="^ /template/ menus|GlidingIndicator#PART_Highlight">
                <Setter Property="Fill" Value="#FF5A5A5A" />
            </Style>
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
            </Setter>
            <Style Selector="^ /template/ StackPanel#PART_Row">
                <Setter Property="Orientation" Value="Vertical" />
            </Style>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.52" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:ButtonGroupItem}" TargetType="local:ButtonGroupItem">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="PART_Divider"
                            Width="1"
                            Margin="0,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="#FFE5E5E5"
                            IsHitTestVisible="False" />
                    <Panel Name="PART_Content"
                           Margin="{TemplateBinding Padding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="50%,50%">
                        <ContentPresenter Content="{TemplateBinding Phase}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="10,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Style Selector="^:has-icon /template/ Panel#PART_Content">
            <Setter Property="Margin" Value="10,0,14,0" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Divider">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:joined /template/ Border#PART_Divider">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:quiet /template/ Border#PART_Divider">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:icon-only, ^:collapsed">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:small">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,0,11,0" />
        </Style>
        <Style Selector="^:small:icon-only, ^:small:collapsed">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ Panel#PART_Content">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Divider">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>
        <Style Selector="^:vertical:icon-only /template/ Panel#PART_Content">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:inert /template/ Panel#PART_Content">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:pressed:not(:inert) /template/ Panel#PART_Content">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="^:pressed:icon-only:not(:inert) /template/ Panel#PART_Content">
            <Setter Property="RenderTransform" Value="scale(0.9)" />
        </Style>
        <Style Selector="^:done">
            <Setter Property="Background" Value="#FFEAF1EA" />
            <Setter Property="Foreground" Value="#FF353535" />
        </Style>
        <Style Selector="^:busy">
            <Setter Property="Cursor" Value="AppStarting" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="No" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type menus:MenuSurface}" TargetType="menus:MenuSurface">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="208" />
        <Setter Property="MaxHeight" Value="300" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Panel Name="PART_ItemsHost">
                            <menus:GlidingIndicator Name="PART_Highlight" Spring="Snappy" CornerRadius="6"
                                                    Fill="{DynamicResource SystemControlHighlightListLowBrush}" />
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:danger-highlight /template/ menus|GlidingIndicator#PART_Highlight">
            <Setter Property="Fill" Value="#18FF4D4F" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type menus:MenuEntry}" TargetType="menus:MenuEntry">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Margin="4,4"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            IsVisible="{TemplateBinding HasSeparatorBefore}" />
                    <Border Name="PART_Row" MinHeight="34" Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Panel Width="16" Margin="0,0,9,0" VerticalAlignment="Center"
                                   IsVisible="{TemplateBinding HasIconSlot}">
                                <ContentPresenter Content="{TemplateBinding IconContent}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}"
                                         IsVisible="{TemplateBinding ShowsRadioDot}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding EffectiveHeaderTemplate}"
                                              VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding GestureText}" Margin="12,0,0,0"
                                       Opacity="0.55" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsDestructive=True]">
            <Setter Property="Foreground" Value="#FF4D4F" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        </Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    </ControlTheme>
</ResourceDictionary>
