<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menus="using:AcrfAnnotationTool.Controls.Menus"
             x:Class="PdfViewerControl.Controls.FreeTextAnnotationControl"
             Background="Transparent"
             ClipToBounds="False"
             UseLayoutRounding="False">
    <menus:ContextMenu.Menu>
        <menus:MenuSurface x:Name="AnnotationMenu" Opened="ContextMenu_OnOpened">
            <menus:MenuEntry Header="Border" InputGestureText="›"><menus:MenuEntry.Items>
                <menus:MenuEntry x:Name="BorderSolidMenuItem" Header="Solid" ToggleType="CheckBox" Click="BorderSolidMenuItem_OnClick" />
                <menus:MenuEntry x:Name="BorderDashedMenuItem" Header="Dashed" ToggleType="CheckBox" Click="BorderDashedMenuItem_OnClick" />
            </menus:MenuEntry.Items></menus:MenuEntry>
            <menus:MenuEntry Header="Callout" InputGestureText="›"><menus:MenuEntry.Items>
                <menus:MenuEntry Header="Left bracket [" Click="CalloutLeftMenuItem_OnClick" />
                <menus:MenuEntry Header="Right bracket ]" Click="CalloutRightMenuItem_OnClick" />
                <menus:MenuEntry Header="Top bracket" CommandParameter="TopBracket" Click="CalloutShapeMenuItem_OnClick" />
                <menus:MenuEntry Header="Bottom bracket" CommandParameter="BottomBracket" Click="CalloutShapeMenuItem_OnClick" />
                <menus:MenuEntry Header="Open arrow" CommandParameter="OpenArrow" Click="CalloutShapeMenuItem_OnClick" />
                <menus:MenuEntry Header="Rectangle" CommandParameter="Rectangle" Click="CalloutShapeMenuItem_OnClick" />
                <menus:MenuEntry Header="Remove callout" Click="CalloutRemoveMenuItem_OnClick" />
            </menus:MenuEntry.Items></menus:MenuEntry>
            <menus:MenuEntry Header="Align" InputGestureText="›"><menus:MenuEntry.Items>
                <menus:MenuEntry x:Name="AlignHLeftMenuItem" Header="Left" ToggleType="CheckBox" Click="AlignHLeftMenuItem_OnClick" />
                <menus:MenuEntry x:Name="AlignHCenterMenuItem" Header="Center" ToggleType="CheckBox" Click="AlignHCenterMenuItem_OnClick" />
                <menus:MenuEntry x:Name="AlignHRightMenuItem" Header="Right" ToggleType="CheckBox" Click="AlignHRightMenuItem_OnClick" />
                <menus:MenuEntry x:Name="AlignVTopMenuItem" Header="Top" HasSeparatorBefore="True" ToggleType="CheckBox" Click="AlignVTopMenuItem_OnClick" />
                <menus:MenuEntry x:Name="AlignVCenterMenuItem" Header="Middle" ToggleType="CheckBox" Click="AlignVCenterMenuItem_OnClick" />
                <menus:MenuEntry x:Name="AlignVBottomMenuItem" Header="Bottom" ToggleType="CheckBox" Click="AlignVBottomMenuItem_OnClick" />
            </menus:MenuEntry.Items></menus:MenuEntry>
            <menus:MenuEntry Header="Background" InputGestureText="›"><menus:MenuEntry.Items>
                <menus:MenuEntry x:Name="BgYellowMenuItem" Header="Yellow" Click="BgYellowMenuItem_OnClick" />
                <menus:MenuEntry x:Name="BgGreenMenuItem" Header="Green" Click="BgGreenMenuItem_OnClick" />
                <menus:MenuEntry x:Name="BgRedMenuItem" Header="Red" Click="BgRedMenuItem_OnClick" />
                <menus:MenuEntry x:Name="BgBlueMenuItem" Header="Blue" Click="BgBlueMenuItem_OnClick" />
                <menus:MenuEntry x:Name="BgWhiteMenuItem" Header="White" Click="BgWhiteMenuItem_OnClick" />
            </menus:MenuEntry.Items></menus:MenuEntry>
            <menus:MenuEntry Header="Font" InputGestureText="›"><menus:MenuEntry.Items>
                <menus:MenuEntry x:Name="FontSize10MenuItem" Header="10" Click="FontSizeMenuItem_OnClick" CommandParameter="10" />
                <menus:MenuEntry x:Name="FontSize12MenuItem" Header="12" Click="FontSizeMenuItem_OnClick" CommandParameter="12" />
                <menus:MenuEntry x:Name="FontSize14MenuItem" Header="14" Click="FontSizeMenuItem_OnClick" CommandParameter="14" />
                <menus:MenuEntry x:Name="FontSize16MenuItem" Header="16" Click="FontSizeMenuItem_OnClick" CommandParameter="16" />
                <menus:MenuEntry x:Name="FontSize20MenuItem" Header="20" Click="FontSizeMenuItem_OnClick" CommandParameter="20" />
                <menus:MenuEntry x:Name="FontSize24MenuItem" Header="24" Click="FontSizeMenuItem_OnClick" CommandParameter="24" />
                <menus:MenuEntry x:Name="BoldMenuItem" Header="Bold" HasSeparatorBefore="True" ToggleType="CheckBox" Click="BoldMenuItem_OnClick" />
            </menus:MenuEntry.Items></menus:MenuEntry>
            <menus:MenuEntry Header="Delete" IsDestructive="True" HasSeparatorBefore="True" Click="DeleteMenuItem_OnClick" />
        </menus:MenuSurface>
    </menus:ContextMenu.Menu>
    <UserControl.Styles>
        <Style Selector="TextBox#Editor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="Black" />
        </Style>
        <Style Selector="TextBox#Editor:focus, TextBox#Editor:pointerover, TextBox#Editor:focus-within">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox#Editor /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox#Editor:focus /template/ Border#PART_BorderElement, TextBox#Editor:pointerover /template/ Border#PART_BorderElement, TextBox#Editor:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="Root" ClipToBounds="False">
        <Border x:Name="Chrome" BorderBrush="Black" BorderThickness="1" Background="#FF87CEEB" Padding="3,2" ClipToBounds="False">
            <Panel>
                <TextBlock x:Name="Placeholder" Text="Insert text here" Foreground="#FFB45309" FontSize="14" FontFamily="Arial" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" IsVisible="False" />
                <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" MinWidth="0" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Hidden" FontSize="14" FontFamily="Arial" Foreground="Black" CaretBrush="Black" />
            </Panel>
        </Border>
        <Rectangle x:Name="DashedBorderFrame" Stroke="Black" StrokeThickness="1" StrokeDashArray="2,2" Fill="Transparent" IsHitTestVisible="False" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="DragOverlay" Background="Transparent" IsVisible="True" Cursor="SizeAll" ClipToBounds="False" />
    </Grid>
</UserControl>