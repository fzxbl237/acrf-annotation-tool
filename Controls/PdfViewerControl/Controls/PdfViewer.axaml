<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:antd-icons="https://atomui.net/icons/antdesign"
             xmlns:atom="https://atomui.net"
             x:Class="PdfViewerControl.Controls.PdfViewer"
             Background="#FFF3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <atom:ComboBox x:Name="ZoomComboBox" Width="88" Height="32" MinHeight="32" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEditable="True" SelectedIndex="2" FontSize="13" FontWeight="Normal" Foreground="#FF6B7280" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6" SelectionChanged="ZoomComboBox_OnSelectionChanged" KeyDown="ZoomComboBox_OnKeyDown" LostFocus="ZoomComboBox_OnLostFocus">
                        <atom:ComboBoxItem Content="50%" />
                        <atom:ComboBoxItem Content="75%" />
                        <atom:ComboBoxItem Content="100%" />
                        <atom:ComboBoxItem Content="125%" />
                        <atom:ComboBoxItem Content="150%" />
                        <atom:ComboBoxItem Content="200%" />
                        <atom:ComboBoxItem Content="300%" />
                        <atom:ComboBoxItem Content="400%" />
                    </atom:ComboBox>
                    <Border Width="1" Height="16" Background="#FFE5E7EB" Margin="8,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="White">
                            <atom:IconButton x:Name="ZoomOutButton" Icon="{antd-icons:AntDesignIconProvider Kind=MinusOutlined}" IconWidth="12" IconHeight="12" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" Foreground="#FF6B7280" Click="ZoomOutButton_OnClick" />
                        </Border>
                        <Border Width="24" Height="24" CornerRadius="6" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="White">
                            <atom:IconButton x:Name="ZoomInButton" Icon="{antd-icons:AntDesignIconProvider Kind=PlusOutlined}" IconWidth="12" IconHeight="12" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" Foreground="#FF6B7280" Click="ZoomInButton_OnClick" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Slider x:Name="ZoomSlider" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" Minimum="25" Maximum="400" Value="100" ValueChanged="ZoomSlider_OnValueChanged" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScrollViewer_OnScrollChanged" PointerPressed="ScrollViewer_OnBackgroundClick">
            <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Margin="16" />
        </ScrollViewer>
        <Grid x:Name="PageNumberHotspot" Grid.Row="1" Height="84" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" ZIndex="10" Background="Transparent" IsHitTestVisible="False" />
        <Border x:Name="PageNumberBar" Grid.Row="1" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="6,3" Background="#F5FFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="10" BoxShadow="0 1 4 #10000000" ZIndex="11" PointerEntered="PageNumberHotspot_OnPointerEntered" PointerExited="PageNumberHotspot_OnPointerExited">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <atom:IconButton x:Name="PrevPageButton" Icon="{antd-icons:AntDesignIconProvider Kind=LeftOutlined}" IconWidth="12" IconHeight="12" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Foreground="#FF6B7280" VerticalAlignment="Center" Click="PrevPage_OnClick" />
                <Border Width="32" Height="24" CornerRadius="4" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBox x:Name="CurrentPageNumberText" Width="30" Height="22" MinWidth="0" MinHeight="0" MaxWidth="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center" Padding="0" BorderThickness="0" FontSize="13" Foreground="#FF6B7280" Text="0" MaxLength="9" TextChanged="CurrentPageNumberText_OnTextChanged" KeyDown="CurrentPageNumberText_OnKeyDown" LostFocus="CurrentPageNumberText_OnLostFocus" />
                </Border>
                <TextBlock Text="/" Margin="3,0" VerticalAlignment="Center" FontSize="13" Foreground="#FF9CA3AF" />
                <TextBlock x:Name="PageCountText" MinWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="13" Foreground="#FF6B7280" />
                <atom:IconButton x:Name="NextPageButton" Icon="{antd-icons:AntDesignIconProvider Kind=RightOutlined}" IconWidth="12" IconHeight="12" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Foreground="#FF6B7280" VerticalAlignment="Center" Click="NextPage_OnClick" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusText" Foreground="#FF6B7280" Text="请打开 PDF 文件" />
        </Border>
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="LoadingOverlay" IsVisible="False" Background="#A6FFFFFF">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" Padding="28,20" BorderBrush="#FFE5E7EB" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                    <TextBlock x:Name="LoadingText" Text="正在加载 PDF…" HorizontalAlignment="Center" Foreground="#FF6B7280" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>