<Application
    x:Class="AcrfAnnotationTool.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:AcrfAnnotationTool"
    xmlns:atom="https://atomui.net"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AcrfAnnotationTool/Controls/ExpandingButtonGroupThemes.axaml" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <Color x:Key="RegionColor">#FFFAFAFA</Color>
                            <Color x:Key="AcrylicFallbackColor">#FFE2E2E2</Color>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="RegionColor">#FF212121</Color>
                            <Color x:Key="AcrylicFallbackColor">#FF1F1F1F</Color>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="atom|AutoComplete">
            <atom:AutoCompletePopupRootStyle x:SetterTargetType="Border">
                <Setter Property="MinWidth" Value="500" />
            </atom:AutoCompletePopupRootStyle>
        </Style>
        <StyleInclude Source="avares://AcrfAnnotationTool/Controls/DataGrid/Themes/DataGridFilterPopup.axaml" />
    </Application.Styles>
</Application>
